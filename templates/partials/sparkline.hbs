{{!-- §25.1 sparkline — consumes charts.mjs sparklineView(). Direction is also
     WORDED (rising/falling/steady), not arrow-only (§25.3). --}}
<span class="ncsoa-sparkline dir-{{dir}}" role="img" aria-label="{{ariaText}}">
  {{#if hasSignal}}
    <svg viewBox="0 0 {{width}} {{height}}" width="{{width}}" height="{{height}}">
      <polyline class="ncsoa-spark-line" points="{{points}}" />
      <circle class="ncsoa-spark-end" cx="{{end.x}}" cy="{{end.y}}" r="2.5" />
    </svg>
    <span class="ncsoa-spark-read">{{#if (eq dir "up")}}<i class="fas fa-arrow-trend-up"></i>{{/if}}{{#if (eq dir "down")}}<i class="fas fa-arrow-trend-down"></i>{{/if}}{{last}} · {{dirWord}}</span>
  {{else}}
    <span class="ncsoa-chart-empty">{{#if label}}{{label}} — {{/if}}not enough history yet.</span>
  {{/if}}
</span>
